<?php

declare(strict_types=1);

/**
 * @file
 * Hook implementations for ldap_role_mapper.
 */

use Drupal\ldap_servers\Helper\CredentialsStorage;
use Drupal\user\UserInterface;

/**
 * Implements hook_user_login().
 *
 * Drupal 11 removed \Drupal\user\Event\UserLoginEvent. Login finalization
 * invokes hook_user_login() from user_login_finalize(). Sync only when this
 * request's LDAP password bind left a DN in CredentialsStorage so local
 * Drupal password logins do not overwrite manually assigned roles.
 */
function ldap_role_mapper_user_login(UserInterface $account): void {
  if (CredentialsStorage::getUserDn() === NULL) {
    return;
  }

  \Drupal::logger('ldap_role_mapper')->info('LDAP Role Mapper: LDAP bind login detected for @name.', [
    '@name' => $account->getAccountName(),
  ]);
  \Drupal::service('ldap_role_mapper.synchronizer')->syncRoles($account);
}

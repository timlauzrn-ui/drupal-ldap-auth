<?php

declare(strict_types=1);

/**
 * @file
 * Friendly navigation and URL UX helpers.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\node\NodeInterface;

/**
 * Implements hook_install().
 */
function hkcec_friendly_navigation_install(): void {
  \Drupal::service('hkcec_friendly_navigation.menu_sync')->syncAll();
  hkcec_friendly_navigation_ensure_parent_field();
}

/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 *
 * Child Basic pages with a Parent department show a back link above content.
 */
function hkcec_friendly_navigation_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\NodeInterface|null $node */
  $node = $variables['node'] ?? NULL;
  if (!$node instanceof NodeInterface || $node->bundle() !== 'page') {
    return;
  }
  if (($variables['view_mode'] ?? '') !== 'full') {
    return;
  }
  if (!$node->hasField('field_parent_department') || $node->get('field_parent_department')->isEmpty()) {
    return;
  }
  $parent = $node->get('field_parent_department')->entity;
  if (!$parent instanceof NodeInterface || !$parent->access('view')) {
    return;
  }
  $back = [
    '#type' => 'container',
    '#attributes' => ['class' => ['gb-parent-back']],
    'link' => [
      '#type' => 'link',
      '#title' => t('← Back to @title', ['@title' => $parent->label()]),
      '#url' => $parent->toUrl(),
      '#attributes' => [
        'class' => ['gb-parent-back__link'],
        'rel' => 'up',
      ],
    ],
    '#weight' => -100,
  ];
  if (isset($variables['content']) && is_array($variables['content'])) {
    $variables['content']['hkcec_parent_back'] = $back;
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function hkcec_friendly_navigation_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $account = \Drupal::currentUser();
  $is_admin = $account->hasPermission('administer url aliases')
    || $account->hasPermission('administer nodes')
    || (int) $account->id() === 1;

  // Hide manual URL alias for non-admins — Pathauto generates it.
  if (!$is_admin) {
    if (isset($form['path'])) {
      $form['path']['#access'] = FALSE;
    }
    if (isset($form['path']['widget'][0]['pathauto'])) {
      $form['path']['#access'] = FALSE;
    }
  }
  else {
    if (isset($form['path']['widget'][0])) {
      $form['path']['widget'][0]['#title'] = t('URL settings (advanced)');
      $form['path']['#open'] = FALSE;
    }
  }

  if (isset($form['field_parent_department'])) {
    $form['field_parent_department']['#weight'] = -5;
  }

  // Simplify Menu settings for everyone.
  if (!isset($form['menu'])) {
    return;
  }

  $form['menu']['#title'] = t('Show in navigation menu');
  $form['menu']['#description'] = t('Add this page to the public Main menu or your department menu. To nest it under a department, choose that department as the parent item (and set Parent department above). The URL is created automatically from the page title.');
  $form['menu']['#open'] = TRUE;

  $menus = \Drupal::service('hkcec_friendly_navigation.menu_sync')->getMenusForAccount($account);
  if (isset($form['menu']['menu_parent'])) {
    $options = $form['menu']['menu_parent']['#options'] ?? [];
    $filtered = [];
    foreach ($options as $key => $label) {
      $menu_id = explode(':', (string) $key, 2)[0];
      if (isset($menus[$menu_id])) {
        $filtered[$key] = $label;
      }
    }
    if ($filtered) {
      $form['menu']['menu_parent']['#options'] = $filtered;
    }
    $form['menu']['menu_parent']['#title'] = t('Menu and parent item');
    $form['menu']['menu_parent']['#description'] = t('Choose Main menu (public) or a department menu, then an optional parent link (for example under Human Resources).');
  }
  if (isset($form['menu']['title'])) {
    $form['menu']['title']['#title'] = t('Menu label');
    $form['menu']['title']['#description'] = t('Text shown in the menu. Defaults to the page title.');
  }
  if (isset($form['menu']['enabled'])) {
    $form['menu']['enabled']['#title'] = t('Show this page in a menu');
  }
}

/**
 * Implements hook_help().
 */
function hkcec_friendly_navigation_help($route_name, \Drupal\Core\Routing\RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.hkcec_friendly_navigation') {
    return '<p>' . t('Pages get automatic URLs from their titles (Pathauto). Use <em>Show this page in a menu</em> on the page form to add links to the public Main menu or your department menu. For second-layer content, set <em>Parent department</em> so visitors can go back to that department (not only Home). Department menus appear as a second navigation bar for members of that department.') . '</p>';
  }
}

/**
 * Department pages a child is allowed to point at.
 *
 * @return array<string, string>
 */
function hkcec_friendly_navigation_parent_targets(): array {
  $targets = [];
  foreach ([
    'department_page',
    'department_page_test',
    'department_page_test_1col',
    'department_page_test_2col',
    'department_page_test_3col',
  ] as $bundle) {
    if (\Drupal\node\Entity\NodeType::load($bundle)) {
      $targets[$bundle] = $bundle;
    }
  }
  return $targets;
}

/**
 * Content types that store Parent department.
 *
 * Basic page keeps the original field. Department page test types use it so a
 * topic page can sit under a department page and be moved later.
 *
 * @return string[]
 */
function hkcec_friendly_navigation_parent_hosts(): array {
  $hosts = ['page'];
  if (function_exists('hkcec_gutenberg_modern_blocks_department_list_bundles')) {
    $hosts = array_merge($hosts, hkcec_gutenberg_modern_blocks_department_list_bundles());
  }
  return array_values(array_unique($hosts));
}

/**
 * Add Parent department on Basic pages and department page test types.
 */
function hkcec_friendly_navigation_ensure_parent_field(): void {
  $targets = hkcec_friendly_navigation_parent_targets();
  if (!$targets) {
    return;
  }
  $storage = \Drupal\field\Entity\FieldStorageConfig::loadByName('node', 'field_parent_department');
  if (!$storage) {
    \Drupal\field\Entity\FieldStorageConfig::create([
      'field_name' => 'field_parent_department',
      'entity_type' => 'node',
      'type' => 'entity_reference',
      'cardinality' => 1,
      'settings' => [
        'target_type' => 'node',
      ],
    ])->save();
  }
  foreach (hkcec_friendly_navigation_parent_hosts() as $bundle) {
    if (!\Drupal\node\Entity\NodeType::load($bundle)) {
      continue;
    }
    $description = $bundle === 'page'
      ? 'Optional. Makes this page a child of a Department page so visitors can go back from the sidebar / breadcrumbs.'
      : 'Optional. Makes this page a child of a department page. The address follows that parent.';
    $field = \Drupal\field\Entity\FieldConfig::loadByName('node', $bundle, 'field_parent_department');
    if (!$field) {
      $field = \Drupal\field\Entity\FieldConfig::create([
        'field_name' => 'field_parent_department',
        'entity_type' => 'node',
        'bundle' => $bundle,
        'label' => 'Parent department',
        'required' => FALSE,
        'description' => $description,
        'settings' => [
          'handler' => 'default:node',
          'handler_settings' => [
            'target_bundles' => $targets,
            'sort' => ['field' => 'title', 'direction' => 'ASC'],
            'auto_create' => FALSE,
          ],
        ],
      ]);
      $field->save();
    }
    else {
      $handler = $field->getSetting('handler_settings') ?: [];
      $handler['target_bundles'] = $targets;
      $handler['sort'] = ['field' => 'title', 'direction' => 'ASC'];
      $handler['auto_create'] = FALSE;
      $field->setSetting('handler_settings', $handler);
      $field->save();
    }
    try {
      $form = \Drupal::service('entity_display.repository')->getFormDisplay('node', $bundle, 'default');
      $form->setComponent('field_parent_department', [
        'type' => 'entity_reference_autocomplete',
        'weight' => -4,
        'settings' => [
          'match_operator' => 'CONTAINS',
          'size' => 60,
          'placeholder' => 'Start typing a department page title…',
        ],
      ])->save();
      $view = \Drupal::service('entity_display.repository')->getViewDisplay('node', $bundle, 'default');
      $view->removeComponent('field_parent_department');
      $view->save();
    }
    catch (\Throwable $e) {
      \Drupal::logger('hkcec_friendly_navigation')->error('Parent department display was not updated for @bundle: @message', [
        '@bundle' => $bundle,
        '@message' => $e->getMessage(),
      ]);
    }
  }
}

<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for department-scoped media folders and access.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\media\MediaInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_install().
 */
function department_access_install(): void {
  \Drupal::service('department_access.role_ensurer')->ensureRoles();
  \Drupal::service('department_access.folder_sync')->sync();
}

/**
 * Implements hook_entity_presave().
 */
function department_access_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof MediaInterface) {
    return;
  }
  \Drupal::service('department_access.media_access')->assignDirectoryFromCurrentUser($entity);
}

/**
 * Implements hook_ENTITY_TYPE_access() for media.
 */
function department_access_media_access(MediaInterface $media, string $operation, AccountInterface $account): AccessResult {
  // Let core/other modules decide create; we constrain via form/presave/query.
  if ($operation === 'create') {
    return AccessResult::neutral()->addCacheContexts(['user.roles']);
  }
  if (!in_array($operation, ['view', 'update', 'delete'], TRUE)) {
    return AccessResult::neutral();
  }
  if (\Drupal::service('department_access.resolver')->canAccessAllFolders($account)) {
    return AccessResult::neutral()->cachePerPermissions()->addCacheContexts(['user.roles']);
  }
  $allowed = \Drupal::service('department_access.media_access')->accountMayAccessMedia($media, $account, $operation);
  return $allowed
    ? AccessResult::allowed()->cachePerUser()->addCacheableDependency($media)
    : AccessResult::forbidden('Media is outside your department folder.')->cachePerUser()->addCacheableDependency($media);
}

/**
 * Implements hook_ENTITY_TYPE_access() for taxonomy terms (hide other dept folders).
 */
function department_access_taxonomy_term_access(TermInterface $term, string $operation, AccountInterface $account): AccessResult {
  $vocab = \Drupal::service('department_access.resolver')->getDirectoryVocabularyId();
  if ($vocab === NULL || $term->bundle() !== $vocab) {
    return AccessResult::neutral();
  }
  if ($operation !== 'view') {
    // Only admins manage folder structure.
    if (\Drupal::service('department_access.resolver')->canAccessAllFolders($account)) {
      return AccessResult::neutral()->cachePerPermissions();
    }
    return AccessResult::forbidden()->cachePerPermissions();
  }
  if (\Drupal::service('department_access.resolver')->canAccessAllFolders($account)) {
    return AccessResult::neutral()->cachePerPermissions();
  }
  // Allow viewing Root and own department folders only.
  if ($term->label() === 'Root') {
    return AccessResult::allowed()->cachePerUser();
  }
  $allowed_tids = \Drupal::service('department_access.resolver')->getUserFolderTermIds($account);
  return in_array((int) $term->id(), $allowed_tids, TRUE)
    ? AccessResult::allowed()->cachePerUser()
    : AccessResult::forbidden()->cachePerUser();
}

/**
 * Implements hook_query_TAG_alter() for media entity queries.
 */
function department_access_query_media_access_alter(Drupal\Core\Database\Query\AlterableInterface $query): void {
  // Core media access often uses entity query; also handle views.
}

/**
 * Implements hook_entity_query_alter().
 */
function department_access_entity_query_alter(Drupal\Core\Entity\Query\QueryInterface $query): void {
  if ($query->getEntityTypeId() !== 'media') {
    return;
  }
  $account = \Drupal::currentUser();
  $resolver = \Drupal::service('department_access.resolver');
  if ($resolver->canAccessAllFolders($account)) {
    return;
  }
  $tids = $resolver->getUserFolderTermIds($account);
  if ($tids === []) {
    // No department: see nothing (or only own unfiled — block via empty directory match).
    $query->condition('directory', -1);
    return;
  }
  $query->condition('directory', $tids, 'IN');
}

/**
 * Implements hook_form_FORM_ID_alter() for media forms — hide directory for dept users.
 */
function department_access_form_media_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $account = \Drupal::currentUser();
  if (\Drupal::service('department_access.resolver')->canAccessAllFolders($account)) {
    return;
  }
  if (isset($form['directory'])) {
    $form['directory']['#access'] = FALSE;
  }
}

/**
 * Implements hook_user_login() — ensure folders exist after LDAP role sync.
 */
function department_access_user_login($account): void {
  // Lightweight: roles already assigned; folders should exist from config sync.
  // Re-sync is cheap (idempotent loadByProperties).
  try {
    \Drupal::service('department_access.folder_sync')->sync();
  }
  catch (\Throwable $e) {
    \Drupal::logger('department_access')->warning('Folder sync on login failed: @m', ['@m' => $e->getMessage()]);
  }
}

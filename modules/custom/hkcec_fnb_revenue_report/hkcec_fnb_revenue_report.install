<?php

declare(strict_types=1);

/**
 * @file
 * Install: content type, fields, private drop directory.
 */

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\node\Entity\NodeType;

/**
 * Implements hook_install().
 */
function hkcec_fnb_revenue_report_install(): void {
  hkcec_fnb_revenue_report_ensure_bundle();
  hkcec_fnb_revenue_report_ensure_drop_folder();
  hkcec_fnb_revenue_report_ensure_roles();
  hkcec_fnb_revenue_report_ensure_calendar();
}

/**
 * Add finance roles and the calendar page on sites that already had this module.
 */
function hkcec_fnb_revenue_report_update_9001(): void {
  hkcec_fnb_revenue_report_ensure_bundle();
  hkcec_fnb_revenue_report_ensure_drop_folder();
  hkcec_fnb_revenue_report_ensure_roles();
  hkcec_fnb_revenue_report_ensure_calendar();
}

/**
 * Ensure content type and fields exist (also callable from configure scripts).
 */
function hkcec_fnb_revenue_report_ensure_bundle(): void {
  if (!NodeType::load('fnb_daily_revenue_report')) {
    $type = NodeType::create([
      'type' => 'fnb_daily_revenue_report',
      'name' => 'F&B Daily Revenue Report',
      'description' => 'Daily F&B revenue PDF linked from the finance calendar.',
      'new_revision' => TRUE,
      'display_submitted' => FALSE,
    ]);
    $type->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_report_date')) {
    FieldStorageConfig::create([
      'field_name' => 'field_report_date',
      'entity_type' => 'node',
      'type' => 'datetime',
      'settings' => ['datetime_type' => 'date'],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'fnb_daily_revenue_report', 'field_report_date')) {
    FieldConfig::create([
      'field_name' => 'field_report_date',
      'entity_type' => 'node',
      'bundle' => 'fnb_daily_revenue_report',
      'label' => 'Report date',
      'required' => TRUE,
      'settings' => [],
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_report_file')) {
    FieldStorageConfig::create([
      'field_name' => 'field_report_file',
      'entity_type' => 'node',
      'type' => 'file',
      'settings' => [
        'target_type' => 'file',
        'display_field' => FALSE,
        'display_default' => FALSE,
        'uri_scheme' => 'private',
      ],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'fnb_daily_revenue_report', 'field_report_file')) {
    FieldConfig::create([
      'field_name' => 'field_report_file',
      'entity_type' => 'node',
      'bundle' => 'fnb_daily_revenue_report',
      'label' => 'Report PDF',
      'required' => TRUE,
      'settings' => [
        'file_directory' => 'fnb-revenue',
        'file_extensions' => 'pdf',
        'max_filesize' => '',
        'description_field' => FALSE,
        'handler' => 'default:file',
        'handler_settings' => [],
      ],
    ])->save();
  }

  if (!FieldStorageConfig::loadByName('node', 'field_source_filename')) {
    FieldStorageConfig::create([
      'field_name' => 'field_source_filename',
      'entity_type' => 'node',
      'type' => 'string',
      'settings' => ['max_length' => 255, 'is_ascii' => FALSE, 'case_sensitive' => FALSE],
      'cardinality' => 1,
      'translatable' => FALSE,
    ])->save();
  }
  if (!FieldConfig::loadByName('node', 'fnb_daily_revenue_report', 'field_source_filename')) {
    FieldConfig::create([
      'field_name' => 'field_source_filename',
      'entity_type' => 'node',
      'bundle' => 'fnb_daily_revenue_report',
      'label' => 'Source filename',
      'required' => FALSE,
      'settings' => [],
    ])->save();
  }

  $form = EntityFormDisplay::load('node.fnb_daily_revenue_report.default')
    ?: EntityFormDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'fnb_daily_revenue_report',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  $form->setComponent('title', ['type' => 'string_textfield', 'weight' => -5]);
  $form->setComponent('field_report_date', [
    'type' => 'datetime_default',
    'weight' => 1,
    'settings' => [],
  ]);
  $form->setComponent('field_report_file', [
    'type' => 'file_generic',
    'weight' => 2,
    'settings' => ['progress_indicator' => 'throbber'],
  ]);
  $form->setComponent('field_source_filename', [
    'type' => 'string_textfield',
    'weight' => 3,
  ]);
  $form->save();

  $view = EntityViewDisplay::load('node.fnb_daily_revenue_report.default')
    ?: EntityViewDisplay::create([
      'targetEntityType' => 'node',
      'bundle' => 'fnb_daily_revenue_report',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  $view->removeComponent('uid');
  $view->removeComponent('created');
  $view->removeComponent('links');
  $view->setComponent('field_report_date', [
    'type' => 'datetime_default',
    'label' => 'inline',
    'weight' => 0,
    'settings' => [
      'timezone_override' => '',
      'format_type' => 'html_date',
    ],
  ]);
  $view->setComponent('field_report_file', [
    'type' => 'file_default',
    'label' => 'hidden',
    'weight' => 1,
    'settings' => ['use_description_as_link_text' => TRUE],
  ]);
  $view->setComponent('field_source_filename', [
    'type' => 'string',
    'label' => 'inline',
    'weight' => 2,
  ]);
  $view->save();
}

/**
 * Ensure the private drop-folder directory exists.
 */
function hkcec_fnb_revenue_report_ensure_drop_folder(): void {
  hkcec_fnb_revenue_report_ensure_private_path();
  $uri = \Drupal::config('hkcec_fnb_revenue_report.settings')->get('drop_folder_uri') ?: 'private://fnb-revenue';
  $fs = \Drupal::service('file_system');
  try {
    $fs->prepareDirectory($uri, \Drupal\Core\File\FileSystemInterface::CREATE_DIRECTORY | \Drupal\Core\File\FileSystemInterface::MODIFY_PERMISSIONS);
  }
  catch (\Throwable $e) {
    \Drupal::logger('hkcec_fnb_revenue_report')->warning('Could not prepare drop folder @uri: @msg', [
      '@uri' => $uri,
      '@msg' => $e->getMessage(),
    ]);
  }
}

/**
 * Point Drupal at sites/default/files/private when no private path is set.
 */
function hkcec_fnb_revenue_report_ensure_private_path(): void {
  $current = \Drupal\Core\Site\Settings::get('file_private_path');
  if (is_string($current) && $current !== '') {
    return;
  }
  $settings = DRUPAL_ROOT . '/sites/default/settings.php';
  $directory = DRUPAL_ROOT . '/sites/default/files/private';
  if (!is_dir($directory) && !@mkdir($directory, 0775, TRUE) && !is_dir($directory)) {
    \Drupal::logger('hkcec_fnb_revenue_report')->warning('Could not create the private files directory.');
    return;
  }
  if (!is_file($directory . '/.htaccess')) {
    @file_put_contents($directory . '/.htaccess', "# Deny all requests from Apache.\nRequire all denied\n");
  }
  if (!is_writable($settings)) {
    \Drupal::logger('hkcec_fnb_revenue_report')->warning('Private file path is not set and settings.php is not writable.');
    return;
  }
  $line = "\n\$settings['file_private_path'] = 'sites/default/files/private';\n";
  if (@file_put_contents($settings, $line, FILE_APPEND) === FALSE) {
    \Drupal::logger('hkcec_fnb_revenue_report')->warning('Could not write the private file path into settings.php.');
  }
}

/**
 * Create the private files directory on sites that already had this module.
 */
function hkcec_fnb_revenue_report_update_9002(): void {
  hkcec_fnb_revenue_report_ensure_private_path();
  hkcec_fnb_revenue_report_ensure_drop_folder();
}

/**
 * Finance and F&B roles that can open the calendar.
 */
function hkcec_fnb_revenue_report_ensure_roles(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('user_role');
  foreach (['fin_dev' => 'FIN Dev', 'fnb_dev' => 'F&B Dev'] as $id => $label) {
    if (!$storage->load($id)) {
      $storage->create(['id' => $id, 'label' => $label])->save();
    }
  }
  $available = array_keys(\Drupal::service('user.permissions')->getPermissions());
  $wanted = [
    'access content',
    'view fnb revenue reports',
    'manage fnb revenue reports',
    'create fnb_daily_revenue_report content',
    'edit any fnb_daily_revenue_report content',
    'delete any fnb_daily_revenue_report content',
  ];
  foreach (['fin_dev', 'fnb_dev'] as $role_id) {
    $role = $storage->load($role_id);
    if (!$role || $role->isAdmin()) {
      continue;
    }
    foreach ($wanted as $permission) {
      if (in_array($permission, $available, TRUE)) {
        $role->grantPermission($permission);
      }
    }
    $role->save();
  }
  $admin = $storage->load('administrator');
  if ($admin && !$admin->isAdmin()) {
    foreach (['view fnb revenue reports', 'manage fnb revenue reports', 'administer fnb revenue report'] as $permission) {
      if (in_array($permission, $available, TRUE)) {
        $admin->grantPermission($permission);
      }
    }
    $admin->save();
  }
}

/**
 * Calendar page at /finance/fnb-revenue-calendar, created once.
 */
function hkcec_fnb_revenue_report_ensure_calendar(): void {
  if (!\Drupal::moduleHandler()->moduleExists('fullcalendar_view') || !\Drupal::moduleHandler()->moduleExists('views')) {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('view');
  if (!$storage->load('fnb_revenue_calendar')) {
    $view = $storage->create([
      'id' => 'fnb_revenue_calendar',
      'label' => 'F&B Revenue Calendar',
      'module' => 'views',
      'base_table' => 'node_field_data',
      'base_field' => 'nid',
      'status' => TRUE,
      'display' => [
        'default' => [
          'display_plugin' => 'default',
          'id' => 'default',
          'display_title' => 'Default',
          'position' => 0,
          'display_options' => [
            'title' => 'F&B Daily Revenue Reports',
            'access' => [
              'type' => 'perm',
              'options' => ['perm' => 'view fnb revenue reports'],
            ],
            'cache' => ['type' => 'tag', 'options' => []],
            'query' => ['type' => 'views_query', 'options' => []],
            'exposed_form' => ['type' => 'basic', 'options' => []],
            'pager' => ['type' => 'none', 'options' => ['offset' => 0]],
            'style' => [
              'type' => 'fullcalendar_view_display',
              'options' => [
                'default_date_source' => 'now',
                'defaultDate' => 'today',
                'start' => 'field_report_date',
                'end' => '',
                'title' => 'title',
                'right_buttons' => 'dayGridMonth,timeGridWeek,listYear',
                'default_view' => 'dayGridMonth',
              ],
            ],
            'row' => ['type' => 'fields'],
            'fields' => [
              'title' => [
                'id' => 'title',
                'table' => 'node_field_data',
                'field' => 'title',
                'plugin_id' => 'field',
                'label' => '',
                'alter' => ['alter_text' => FALSE],
                'element_default_classes' => TRUE,
                'type' => 'string',
                'settings' => ['link_to_entity' => TRUE],
              ],
              'field_report_date' => [
                'id' => 'field_report_date',
                'table' => 'node__field_report_date',
                'field' => 'field_report_date',
                'plugin_id' => 'field',
                'label' => '',
                'type' => 'datetime_default',
                'settings' => [
                  'timezone_override' => '',
                  'format_type' => 'html_date',
                ],
              ],
            ],
            'filters' => [
              'status' => [
                'id' => 'status',
                'table' => 'node_field_data',
                'field' => 'status',
                'plugin_id' => 'boolean',
                'value' => '1',
                'group' => 1,
                'expose' => ['operator' => FALSE],
              ],
              'type' => [
                'id' => 'type',
                'table' => 'node_field_data',
                'field' => 'type',
                'plugin_id' => 'bundle',
                'value' => ['fnb_daily_revenue_report' => 'fnb_daily_revenue_report'],
                'group' => 1,
              ],
            ],
            'filter_groups' => [
              'operator' => 'AND',
              'groups' => [1 => 'AND'],
            ],
          ],
        ],
        'page_1' => [
          'display_plugin' => 'page',
          'id' => 'page_1',
          'display_title' => 'Page',
          'position' => 1,
          'display_options' => [
            'path' => 'finance/fnb-revenue-calendar',
            'menu' => [
              'type' => 'normal',
              'title' => 'F&B Revenue Calendar',
              'description' => 'Daily F&B revenue reports',
              'expanded' => FALSE,
              'parent' => 'system.admin_reports',
              'weight' => 10,
              'context' => '0',
              'menu_name' => 'admin',
            ],
            'display_extenders' => [],
          ],
        ],
      ],
    ]);
    $view->save();
  }

  $links = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $found = $links->loadByProperties([
    'link.uri' => 'internal:/finance/fnb-revenue-calendar',
    'menu_name' => 'main',
  ]);
  if (!$found) {
    $links->create([
      'title' => 'F&B Revenue Calendar',
      'link' => ['uri' => 'internal:/finance/fnb-revenue-calendar'],
      'menu_name' => 'main',
      'weight' => 50,
      'enabled' => TRUE,
    ])->save();
  }
}

<?php

declare(strict_types=1);

/**
 * @file
 * Role-aware Gutenberg template locking.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\node\NodeInterface;
use Drupal\node\NodeTypeInterface;

/**
 * Gutenberg template lock for the current node bundle.
 *
 * @return mixed
 *   FALSE when unlocked, or a Gutenberg lock string (all/insert/contentOnly).
 */
function hkcec_gutenberg_template_lock_value_for_bundle(?string $bundle, bool $can_unlock) {
  if ($can_unlock) {
    return FALSE;
  }
  if (!$bundle) {
    return 'all';
  }
  $lock = \Drupal::config('gutenberg.settings')->get($bundle . '_template_lock');
  if (!is_string($lock) || $lock === '' || strtolower($lock) === 'none' || $lock === '0') {
    return FALSE;
  }
  if ($lock === 'All') {
    return 'all';
  }
  return $lock;
}

/**
 * Current node bundle on add/edit routes, if any.
 */
function hkcec_gutenberg_template_lock_current_bundle(): ?string {
  $route = \Drupal::routeMatch();
  $node = $route->getParameter('node');
  if ($node instanceof NodeInterface) {
    return $node->bundle();
  }
  $type = $route->getParameter('node_type');
  if ($type instanceof NodeTypeInterface) {
    return $type->id();
  }
  if (is_string($type) && $type !== '') {
    return $type;
  }
  return NULL;
}

/**
 * Implements hook_page_attachments().
 */
function hkcec_gutenberg_template_lock_page_attachments(array &$attachments): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if (!is_string($route)) {
    return;
  }
  $is_node_form = in_array($route, ['node.add', 'entity.node.edit_form'], TRUE)
    || (str_starts_with($route, 'entity.node.') && str_contains($route, 'form'));
  if (!$is_node_form) {
    return;
  }

  $account = \Drupal::currentUser();
  $can_unlock = $account->hasPermission('unlock gutenberg template')
    || $account->hasPermission('administer nodes')
    || (int) $account->id() === 1;
  $lock = hkcec_gutenberg_template_lock_value_for_bundle(
    hkcec_gutenberg_template_lock_current_bundle(),
    $can_unlock
  );

  $attachments['#attached']['library'][] = 'hkcec_gutenberg_template_lock/hkcec_gutenberg_template_lock';
  $attachments['#attached']['drupalSettings']['hkcec_gutenberg_template_lock'] = [
    'templateLock' => $lock,
    'canUnlock' => $can_unlock,
  ];
  // Gutenberg.js reads this hyphenated key at boot. Admins must not stay locked
  // or the inserter (including Patterns) stays empty.
  $attachments['#attached']['drupalSettings']['gutenberg']['template-lock'] = ($lock === FALSE) ? 'none' : $lock;
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Gutenberg sets template-lock from config after our hook_page_attachments().
 * Re-apply the role-aware value so the inserter/Patterns can load for unlockers.
 */
function hkcec_gutenberg_template_lock_page_attachments_alter(array &$attachments): void {
  if (empty($attachments['#attached']['drupalSettings']['hkcec_gutenberg_template_lock'])) {
    return;
  }
  $lock = $attachments['#attached']['drupalSettings']['hkcec_gutenberg_template_lock']['templateLock'];
  $attachments['#attached']['drupalSettings']['gutenberg']['template-lock'] = ($lock === FALSE) ? 'none' : $lock;
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node forms.
 */
function hkcec_gutenberg_template_lock_form_node_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $account = \Drupal::currentUser();
  $can_unlock = $account->hasPermission('unlock gutenberg template')
    || $account->hasPermission('administer nodes')
    || (int) $account->id() === 1;

  $bundle = NULL;
  $form_object = $form_state->getFormObject();
  if (method_exists($form_object, 'getEntity')) {
    $entity = $form_object->getEntity();
    if ($entity instanceof NodeInterface) {
      $bundle = $entity->bundle();
    }
  }
  $lock = hkcec_gutenberg_template_lock_value_for_bundle($bundle, $can_unlock);

  $form['#attached']['library'][] = 'hkcec_gutenberg_template_lock/hkcec_gutenberg_template_lock';
  $form['#attached']['drupalSettings']['hkcec_gutenberg_template_lock'] = [
    'templateLock' => $lock,
    'canUnlock' => $can_unlock,
  ];
  $form['#attached']['drupalSettings']['gutenberg']['template-lock'] = ($lock === FALSE) ? 'none' : $lock;
  $form['#attached']['drupalSettings']['gutenberg']['templateLock'] = $lock;

  $form['#validate'][] = 'hkcec_gutenberg_template_lock_node_form_validate';
}

/**
 * Validate that non-unlock users do not remove locked template root blocks.
 */
function hkcec_gutenberg_template_lock_node_form_validate(array &$form, FormStateInterface $form_state): void {
  $account = \Drupal::currentUser();
  if ($account->hasPermission('unlock gutenberg template')
    || $account->hasPermission('administer nodes')
    || (int) $account->id() === 1) {
    return;
  }

  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface) {
    return;
  }

  $type = $node->bundle();
  $config = \Drupal::config('gutenberg.settings');
  $lock = $config->get($type . '_template_lock');
  if ($lock !== 'all' && $lock !== 'All') {
    return;
  }

  $template_json = $config->get($type . '_template');
  if (!is_string($template_json) || $template_json === '') {
    return;
  }

  $template = json_decode($template_json, TRUE);
  if (!is_array($template) || $template === []) {
    return;
  }

  $expected_roots = [];
  foreach ($template as $block) {
    if (is_array($block) && isset($block[0]) && is_string($block[0])) {
      $expected_roots[] = $block[0];
    }
  }
  if ($expected_roots === []) {
    return;
  }

  // Body field may be body[0][value] depending on widget.
  $body = $form_state->getValue('body');
  $markup = '';
  if (is_array($body)) {
    $markup = (string) ($body[0]['value'] ?? $body['value'] ?? '');
  }
  elseif (is_string($body)) {
    $markup = $body;
  }

  if ($markup === '') {
    return;
  }

  $actual_roots = hkcec_gutenberg_template_lock_extract_root_block_names($markup);
  if ($actual_roots === []) {
    return;
  }

  // Allow content edits inside blocks; require same root block types in order.
  if ($actual_roots !== $expected_roots) {
    $form_state->setErrorByName('body', t('You are not allowed to move, delete, or add template blocks. Only administrators (or users with “Unlock Gutenberg template”) can change page structure.'));
  }
}

/**
 * Extract top-level Gutenberg block names from saved markup.
 *
 * @return string[]
 *   Ordered list of root block names (e.g. core/heading).
 */
function hkcec_gutenberg_template_lock_extract_root_block_names(string $markup): array {
  $roots = [];
  // Match Gutenberg block comments ending with --> (not a lone >).
  // Examples: <!-- wp:heading -->, <!-- /wp:heading -->, <!-- wp:image /-->.
  $offset = 0;
  $depth = 0;
  $length = strlen($markup);
  while ($offset < $length) {
    if (!preg_match('/<!--\s+(\/)?wp:([a-z0-9\-\/]+)(?:\s+(\{.*?\}))?\s*(\/)?-->/', $markup, $m, PREG_OFFSET_CAPTURE, $offset)) {
      break;
    }
    $full = $m[0][0];
    $pos = $m[0][1];
    $is_close = ($m[1][0] ?? '') === '/';
    $name = $m[2][0];
    $self_closing = ($m[4][0] ?? '') === '/';

    if ($is_close) {
      $depth = max(0, $depth - 1);
    }
    else {
      if ($depth === 0) {
        // Normalize short names to core/* when missing namespace.
        $roots[] = str_contains($name, '/') ? $name : ('core/' . $name);
      }
      if (!$self_closing) {
        $depth++;
      }
    }
    $offset = $pos + strlen($full);
  }
  return $roots;
}

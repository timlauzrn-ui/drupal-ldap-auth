<?php

declare(strict_types=1);

/**
 * @file
 * Hooks for department-scoped media folders and access.
 */

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\media\MediaInterface;
use Drupal\taxonomy\TermInterface;

/**
 * Implements hook_install().
 */
function hkcec_department_access_install(): void {
  hkcec_department_access_ensure_folders();
}

/**
 * Implements hook_entity_presave().
 */
function hkcec_department_access_entity_presave(EntityInterface $entity): void {
  if (!$entity instanceof MediaInterface) {
    return;
  }
  \Drupal::service('hkcec_department_access.media_access')->assignDirectoryFromCurrentUser($entity);
}

/**
 * Implements hook_ENTITY_TYPE_access() for media.
 */
function hkcec_department_access_media_access(MediaInterface $media, string $operation, AccountInterface $account): AccessResult {
  // Let core/other modules decide create; we constrain via form/presave/query.
  if ($operation === 'create') {
    return AccessResult::neutral()->addCacheContexts(['user.roles']);
  }
  if (!in_array($operation, ['view', 'update', 'delete'], TRUE)) {
    return AccessResult::neutral();
  }
  if (\Drupal::service('hkcec_department_access.resolver')->canAccessAllFolders($account)) {
    return AccessResult::neutral()->cachePerPermissions()->addCacheContexts(['user.roles']);
  }
  $allowed = \Drupal::service('hkcec_department_access.media_access')->accountMayAccessMedia($media, $account, $operation);
  return $allowed
    ? AccessResult::allowed()->cachePerUser()->addCacheableDependency($media)
    : AccessResult::forbidden('Media is outside your department folder.')->cachePerUser()->addCacheableDependency($media);
}

/**
 * Implements hook_ENTITY_TYPE_access() for taxonomy terms (hide other dept folders).
 */
function hkcec_department_access_taxonomy_term_access(TermInterface $term, string $operation, AccountInterface $account): AccessResult {
  $vocab = \Drupal::service('hkcec_department_access.resolver')->getDirectoryVocabularyId();
  if ($vocab === NULL || $term->bundle() !== $vocab) {
    return AccessResult::neutral();
  }
  if ($operation !== 'view') {
    // Only admins manage folder structure.
    if (\Drupal::service('hkcec_department_access.resolver')->canAccessAllFolders($account)) {
      return AccessResult::neutral()->cachePerPermissions();
    }
    return AccessResult::forbidden()->cachePerPermissions();
  }
  if (\Drupal::service('hkcec_department_access.resolver')->canAccessAllFolders($account)) {
    return AccessResult::neutral()->cachePerPermissions();
  }
  // Allow viewing Root and own department folders only.
  if ($term->label() === 'Root') {
    return AccessResult::allowed()->cachePerUser();
  }
  $allowed_tids = \Drupal::service('hkcec_department_access.resolver')->getUserFolderTermIds($account);
  return in_array((int) $term->id(), $allowed_tids, TRUE)
    ? AccessResult::allowed()->cachePerUser()
    : AccessResult::forbidden()->cachePerUser();
}

/**
 * Implements hook_query_TAG_alter() for media entity queries.
 */
function hkcec_department_access_query_media_access_alter(Drupal\Core\Database\Query\AlterableInterface $query): void {
  // Core media access often uses entity query; also handle views.
}

/**
 * Implements hook_entity_query_alter().
 */
function hkcec_department_access_entity_query_alter(Drupal\Core\Entity\Query\QueryInterface $query): void {
  if ($query->getEntityTypeId() !== 'media') {
    return;
  }
  $account = \Drupal::currentUser();
  $resolver = \Drupal::service('hkcec_department_access.resolver');
  if ($resolver->canAccessAllFolders($account)) {
    return;
  }
  $tids = $resolver->getUserFolderTermIds($account);
  if ($tids === []) {
    // No department folder: only own unfiled media (friendlier than seeing nothing).
    $own = $query->andConditionGroup()
      ->notExists('directory')
      ->condition('uid', (int) $account->id());
    $query->condition($own);
    return;
  }
  // Department folders OR own still-unfiled uploads (so library does not look empty
  // right after a Gutenberg upload before directory assignment is visible).
  $or = $query->orConditionGroup()
    ->condition('directory', $tids, 'IN');
  $own_unfiled = $query->andConditionGroup()
    ->notExists('directory')
    ->condition('uid', (int) $account->id());
  $or->condition($own_unfiled);
  $query->condition($or);
}

/**
 * Implements hook_form_FORM_ID_alter() for media forms — hide directory for dept users.
 */
function hkcec_department_access_form_media_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $account = \Drupal::currentUser();
  if (\Drupal::service('hkcec_department_access.resolver')->canAccessAllFolders($account)) {
    return;
  }
  if (isset($form['directory'])) {
    $form['directory']['#access'] = FALSE;
  }
  // Friendly notice: uploads are auto-filed.
  $folder = _hkcec_department_access_folder_label_for_account($account);
  $message = $folder
    ? t('Drag and drop or browse to upload. New media is saved under <strong>@folder</strong> for your department.', ['@folder' => $folder])
    : t('Drag and drop or browse to upload. New media is filed into your department folder automatically.');
  $form['hkcec_media_friendly'] = [
    '#type' => 'markup',
    '#markup' => '<div class="messages messages--status" role="status">' . $message . '</div>',
    '#weight' => -40,
  ];
}

/**
 * Human-readable primary department folder label for an account.
 */
function _hkcec_department_access_folder_label_for_account(AccountInterface $account): string {
  try {
    $resolver = \Drupal::service('hkcec_department_access.resolver');
    $dept_id = $resolver->getPrimaryDepartmentId($account);
    if ($dept_id === NULL) {
      return '';
    }
    $tid = $resolver->getFolderTermIdForDepartment($dept_id);
    if ($tid === NULL) {
      return '';
    }
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tid);
    if (!$term) {
      return '';
    }
    return 'Root › ' . $term->label();
  }
  catch (\Throwable $e) {
    return '';
  }
}

/**
 * Implements hook_user_login() — ensure folders exist after LDAP role sync.
 */
function hkcec_department_access_user_login($account): void {
  // Lightweight: roles already assigned; folders should exist from config sync.
  // Re-sync is cheap (idempotent loadByProperties).
  try {
    \Drupal::service('hkcec_department_access.folder_sync')->sync();
  }
  catch (\Throwable $e) {
    \Drupal::logger('hkcec_department_access')->warning('Folder sync on login failed: @m', ['@m' => $e->getMessage()]);
  }
}
